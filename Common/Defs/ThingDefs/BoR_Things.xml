<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>BoR_BankUplink</defName>
    <label>Rimica bank uplink</label>
    <description>An encrypted orbital terminal linked to the Bank of Rimica. A colonist can use it to manage the colony's savings, take out loans, accept vault custody contracts and pick up debt collection work.\n\nSilver is deposited and repaid from within range of a powered orbital trade beacon; withdrawals and loans arrive by drop pod.</description>
    <thingClass>BankOfRimica.Building_BankUplink</thingClass>
    <graphicData>
      <texPath>Things/Building/Misc/CommsConsole</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,2)</drawSize>
      <color>(170,190,215)</color>
      <shadowData>
        <volume>(2.6, 0.75, 1.4)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <blockWind>true</blockWind>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>0.5</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <size>(3,2)</size>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>2500</WorkToBuild>
      <Flammability>0.5</Flammability>
      <Mass>40</Mass>
    </statBases>
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
      <Silver>50</Silver>
    </costList>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <designationCategory>Misc</designationCategory>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <researchPrerequisites>
      <li>MicroelectronicsBasics</li>
    </researchPrerequisites>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>200</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
    </comps>
  </ThingDef>

  <!-- One bar = 10,000 silver; a full stack of 100 fills a pallet. Art: vanilla gold bricks re-tinted to silver at load. -->
  <ThingDef>
    <defName>BoR_Bullion</defName>
    <label>Rimica silver bar</label>
    <description>A sealed, serial-numbered bar of refined silver belonging to the Bank of Rimica, worth 10,000 silver. It is held here under a custody contract: it cannot be sold, and every bar that goes missing will be charged to the colony.\n\nThieves love it.</description>
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <drawerType>MapMeshOnly</drawerType>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <useHitPoints>false</useHitPoints>
    <selectable>true</selectable>
    <altitudeLayer>Item</altitudeLayer>
    <stackLimit>100</stackLimit>
    <alwaysHaulable>true</alwaysHaulable>
    <drawGUIOverlay>true</drawGUIOverlay>
    <rotatable>false</rotatable>
    <pathCost>14</pathCost>
    <tradeability>None</tradeability>
    <graphicData>
      <texPath>Things/Item/Resource/Gold</texPath>
      <graphicClass>BankOfRimica.Graphic_SilverStackCount</graphicClass>
      <!-- must differ from vanilla gold's colour so the silvered materials aren't shared with it -->
      <color>(254,254,254)</color>
    </graphicData>
    <soundInteract>Silver_Drop</soundInteract>
    <soundDrop>Silver_Drop</soundDrop>
    <statBases>
      <MarketValue>10000</MarketValue>
      <Mass>12</Mass>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
      <Beauty>5</Beauty>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Forbiddable" />
    </comps>
  </ThingDef>

  <!-- Dropped by the bank shuttle where the player chooses; holds only bank silver bars. -->
  <ThingDef ParentName="BuildingBase">
    <defName>BoR_BankPallet</defName>
    <label>Rimica bank pallet</label>
    <description>A reinforced pallet stamped with the Bank of Rimica seal. It holds the bank's silver bars while your colony hosts them, and goes back on the bank shuttle when the contract ends.</description>
    <thingClass>BankOfRimica.Building_BankPallet</thingClass>
    <graphicData>
      <texPath>Things/Building/BoR_BankPallet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.2</fillPercent>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <useHitPoints>false</useHitPoints>
    <canOverlapZones>false</canOverlapZones>
    <surfaceType>Item</surfaceType>
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
    <inspectorTabs>
      <li>ITab_Storage</li>
    </inspectorTabs>
    <building>
      <claimable>false</claimable>
      <isInert>true</isInert>
      <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <fixedStorageSettings>
        <filter>
          <thingDefs>
            <li>BoR_Bullion</li>
          </thingDefs>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Critical</priority>
        <filter>
          <thingDefs>
            <li>BoR_Bullion</li>
          </thingDefs>
        </filter>
      </defaultStorageSettings>
    </building>
  </ThingDef>

  <!-- Bank shuttle. Art is swapped for Odyssey's passenger shuttle at startup when found. -->
  <ThingDef ParentName="SkyfallerBase">
    <defName>BoR_BankShuttleIncoming</defName>
    <label>bank shuttle (incoming)</label>
    <thingClass>BankOfRimica.Skyfaller_BankShuttle</thingClass>
    <size>(3,3)</size>
    <graphicData>
      <texPath>Things/Building/BoR_BankShuttle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(4,4)</drawSize>
    </graphicData>
    <skyfaller>
      <movementType>Decelerate</movementType>
      <shadow>Things/Skyfaller/SkyfallerShadowDropPod</shadow>
      <shadowSize>(3,3)</shadowSize>
      <anticipationSound>DropPod_Fall</anticipationSound>
      <anticipationSoundTicks>100</anticipationSoundTicks>
      <motesPerCell>1</motesPerCell>
      <ticksToImpactRange>200~250</ticksToImpactRange>
    </skyfaller>
  </ThingDef>

  <ThingDef ParentName="SkyfallerBase">
    <defName>BoR_BankShuttleLeaving</defName>
    <label>bank shuttle (leaving)</label>
    <thingClass>BankOfRimica.Skyfaller_BankShuttleLeaving</thingClass>
    <size>(3,3)</size>
    <graphicData>
      <texPath>Things/Building/BoR_BankShuttle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(4,4)</drawSize>
    </graphicData>
    <skyfaller>
      <movementType>Decelerate</movementType>
      <reversed>true</reversed>
      <shadow>Things/Skyfaller/SkyfallerShadowDropPod</shadow>
      <shadowSize>(3,3)</shadowSize>
      <anticipationSound>DropPod_Leaving</anticipationSound>
      <anticipationSoundTicks>-10</anticipationSoundTicks>
      <ticksToImpactRange>-40~-15</ticksToImpactRange>
    </skyfaller>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>BoR_BankShuttleLanded</defName>
    <label>Rimica bank shuttle</label>
    <description>A Bank of Rimica cargo shuttle. It won't stay long.</description>
    <thingClass>BankOfRimica.Building_BankShuttle</thingClass>
    <graphicData>
      <texPath>Things/Building/BoR_BankShuttle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(4,4)</drawSize>
    </graphicData>
    <size>(3,3)</size>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <useHitPoints>false</useHitPoints>
    <tickerType>Normal</tickerType>
    <rotatable>false</rotatable>
    <canOverlapZones>true</canOverlapZones>
    <building>
      <claimable>false</claimable>
      <isInert>true</isInert>
    </building>
  </ThingDef>

</Defs>
