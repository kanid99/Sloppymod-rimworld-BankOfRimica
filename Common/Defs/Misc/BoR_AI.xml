<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <JobDef>
    <defName>BoR_UseBankUplink</defName>
    <driverClass>BankOfRimica.JobDriver_UseBankUplink</driverClass>
    <reportString>contacting the Bank of Rimica.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <JobDef>
    <defName>BoR_StealBullion</defName>
    <driverClass>BankOfRimica.JobDriver_StealBullion</driverClass>
    <reportString>stealing TargetA.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <JobDef>
    <defName>BoR_BoardGetaway</defName>
    <driverClass>BankOfRimica.JobDriver_BoardGetaway</driverClass>
    <reportString>escaping on TargetA.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <!-- Bank heist raiders: anyone holding silver runs for the getaway craft; the rest defend themselves up close, grab silver, and fall back to a normal assault once it's gone. -->
  <DutyDef>
    <defName>BoR_BankHeist</defName>
    <alwaysShowWeapon>true</alwaysShowWeapon>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="BankOfRimica.JobGiver_EscapeWithBullion" />
        <li Class="JobGiver_TakeCombatEnhancingDrug" />
        <li Class="JobGiver_AIFightEnemies">
          <targetAcquireRadius>8</targetAcquireRadius>
          <targetKeepRadius>12</targetKeepRadius>
        </li>
        <li Class="BankOfRimica.JobGiver_StealBullion" />
        <li Class="JobGiver_AIFightEnemies">
          <targetAcquireRadius>65</targetAcquireRadius>
          <targetKeepRadius>72</targetKeepRadius>
        </li>
        <li Class="JobGiver_AITrashColonyClose" />
        <li Class="JobGiver_AITrashBuildingsDistant" />
        <li Class="JobGiver_AIGotoNearestHostile" />
        <li Class="JobGiver_AISapper">
          <canMineNonMineables>false</canMineNonMineables>
        </li>
      </subNodes>
    </thinkNode>
  </DutyDef>

  <!-- Warcasket cover force pulling out once the thieves are gone. -->
  <DutyDef>
    <defName>BoR_HeistCoverBoard</defName>
    <alwaysShowWeapon>true</alwaysShowWeapon>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="JobGiver_AIFightEnemies">
          <targetAcquireRadius>6</targetAcquireRadius>
          <targetKeepRadius>8</targetKeepRadius>
        </li>
        <li Class="BankOfRimica.JobGiver_CoverBoardGetaway" />
        <li Class="JobGiver_ExitMapBest">
          <defaultLocomotion>Jog</defaultLocomotion>
        </li>
      </subNodes>
    </thinkNode>
  </DutyDef>

  <RaidStrategyDef>
    <defName>BoR_BankHeistStrategy</defName>
    <workerClass>BankOfRimica.RaidStrategyWorker_BankHeist</workerClass>
    <selectionWeightPerPointsCurve>
      <points>
        <li>(0, 0)</li>
        <li>(100000, 0)</li>
      </points>
    </selectionWeightPerPointsCurve>
    <pointsFactorCurve>
      <points>
        <li>(0, 1)</li>
        <li>(100000, 1)</li>
      </points>
    </pointsFactorCurve>
    <arriveModes>
      <li>EdgeWalkIn</li>
      <li>EdgeDrop</li>
    </arriveModes>
    <letterLabelEnemy>Bank heist</letterLabelEnemy>
    <arrivalTextEnemy>They have come for the Bank of Rimica's bullion. Once they have silver they will call in a getaway craft. Anyone who boards it and takes off is gone for good, and every bar they get away with will be charged to you. Destroy the craft before it lifts off and they'll spill out.</arrivalTextEnemy>
    <letterLabelFriendly>Friendlies</letterLabelFriendly>
    <arrivalTextFriendly>They are here.</arrivalTextFriendly>
  </RaidStrategyDef>

  <!-- Never picked by storytellers (baseChance 0); launched by the custody contract. -->
  <IncidentDef>
    <defName>BoR_BankHeistRaid</defName>
    <label>bank heist</label>
    <category>ThreatBig</category>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>BankOfRimica.IncidentWorker_BankHeist</workerClass>
    <baseChance>0</baseChance>
    <pointsScaleable>true</pointsScaleable>
    <letterDef>ThreatBig</letterDef>
  </IncidentDef>

</Defs>
