<Project Sdk="Microsoft.NET.Sdk">
  <!-- Requires RimWorld 1.6 + Odyssey. Build with Source/BankOfRimica/build.sh -->
  <PropertyGroup>
    <RimVersion Condition="'$(RimVersion)' == ''">1.6</RimVersion>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>BankOfRimica</RootNamespace>
    <AssemblyName>BankOfRimica</AssemblyName>
    <OutputPath>../../$(RimVersion)/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup Condition="'$(RimVersion)' == '1.6'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
